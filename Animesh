
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hello, Animesh!</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Inter, Arial, sans-serif;
      background: #0b1220;
      color: #ffffff;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .container {
      width: 100%;
      max-width: 700px;
      text-align: center;
    }

    .tag {
      display: inline-block;
      color: #5eead4;
      background: #122c35;
      border: 1px solid #24535b;
      padding: 8px 14px;
      border-radius: 30px;
      font-size: 13px;
      margin-bottom: 24px;
    }

    h1 {
      font-size: clamp(38px, 8vw, 64px);
      letter-spacing: -2px;
      margin-bottom: 16px;
    }

    h1 span {
      color: #5eead4;
    }

    .subtitle {
      color: #a8b6ca;
      line-height: 1.7;
      margin-bottom: 32px;
    }

    .game {
      background: #131e30;
      border: 1px solid #29384d;
      padding: 24px;
      border-radius: 20px;
      text-align: left;
    }

    .game h2 {
      margin-bottom: 8px;
    }

    .game p {
      color: #a8b6ca;
      font-size: 14px;
      line-height: 1.6;
    }

    .stats {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin: 22px 0 14px;
    }

    .stat {
      background: #0b1220;
      padding: 14px;
      border-radius: 12px;
      flex: 1;
    }

    .stat small {
      display: block;
      color: #94a3b8;
      margin-bottom: 6px;
    }

    .stat strong {
      font-size: 24px;
    }

    .arena {
      height: 190px;
      background: #0b1220;
      border: 1px solid #29384d;
      border-radius: 14px;
      position: relative;
      overflow: hidden;
      margin-bottom: 16px;
    }

    #target {
      width: 46px;
      height: 46px;
      position: absolute;
      display: none;
      align-items: center;
      justify-content: center;
      border: none;
      border-radius: 50%;
      background: #14b8a6;
      color: #ffffff;
      font-size: 22px;
      cursor: pointer;
      box-shadow: 0 0 25px #14b8a655;
      transition: left 0.12s, top 0.12s;
    }

    #target:hover {
      background: #2dd4bf;
    }

    .message {
      text-align: center;
      padding: 10px;
      color: #a8b6ca;
      font-size: 14px;
    }

    .button {
      width: 100%;
      border: none;
      border-radius: 12px;
      padding: 15px;
      background: #14b8a6;
      color: #062d2b;
      font-weight: 700;
      font-size: 15px;
      cursor: pointer;
    }

    .button:hover {
      background: #5eead4;
    }

    footer {
      margin-top: 28px;
      font-size: 12px;
      color: #64748b;
    }
  </style>
</head>

<body>
  <main class="container">
    <div class="tag">✦ WELCOME TO MY WEBSITE</div>

    <h1>Hello, <span>Animesh!</span> 👋</h1>

    <p class="subtitle">
      A little corner of the internet built with code.
      <br />Stay curious. Keep creating. Have fun.
    </p>

    <section class="game">
      <h2>🎮 Click Rush</h2>
      <p>Click the moving target as many times as possible in 30 seconds.</p>

      <div class="stats">
        <div class="stat">
          <small>YOUR SCORE</small>
          <strong id="score">0</strong>
        </div>
        <div class="stat">
          <small>TIME LEFT</small>
          <strong><span id="time">30</span>s</strong>
        </div>
      </div>

      <div class="arena" id="arena">
        <div class="message" id="message">
          Press Start Game to begin!
        </div>
        <button id="target" aria-label="Click the target">✦</button>
      </div>

      <button class="button" id="start">Start Game</button>
    </section>

    <footer>Made with HTML, CSS & JavaScript · © 2026 Animesh</footer>
  </main>

  <script>
    const scoreElement = document.getElementById("score");
    const timeElement = document.getElementById("time");
    const arena = document.getElementById("arena");
    const target = document.getElementById("target");
    const message = document.getElementById("message");
    const startButton = document.getElementById("start");

    let score = 0;
    let timeLeft = 30;
    let playing = false;
    let timer = null;

    function moveTarget() {
      const maxX = arena.clientWidth - target.offsetWidth;
      const maxY = arena.clientHeight - target.offsetHeight;

      target.style.left = Math.random() * maxX + "px";
      target.style.top = Math.random() * maxY + "px";
    }

    function endGame() {
      playing = false;
      clearInterval(timer);
      target.style.display = "none";
      message.style.display = "block";
      message.textContent = `Game over! Your final score is ${score}.`;
      startButton.textContent = "Play Again";
    }

    function startGame() {
      clearInterval(timer);

      score = 0;
      timeLeft = 30;
      playing = true;

      scoreElement.textContent = score;
      timeElement.textContent = timeLeft;
      message.style.display = "none";
      target.style.display = "flex";
      startButton.textContent = "Restart Game";

      moveTarget();

      timer = setInterval(() => {
        timeLeft--;
        timeElement.textContent = timeLeft;

        if (timeLeft <= 0) {
          endGame();
        }
      }, 1000);
    }

    target.addEventListener("click", () => {
      if (!playing) return;

      score++;
      scoreElement.textContent = score;
      moveTarget();
    });

    startButton.addEventListener("click", startGame);
  </script>
</body>
</html>
